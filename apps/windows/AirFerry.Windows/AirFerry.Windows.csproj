<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- Version mirrors apps/sender/package.json, apps/scanner build.gradle.kts,
         and Cargo.toml workspace version — keep all four in sync. -->
    <Version>1.2.2</Version>
    <AssemblyName>AirFerry</AssemblyName>
    <RootNamespace>AirFerry.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Camera + capture-card capture via OpenCV's DirectShow/Media Foundation
         backends. OpenCvSharp4.runtime.win brings the native OpenCV DLLs. -->
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.windows" Version="4.9.0.20240103" />
    <!-- DirectShow video-input device enumeration (webcams + USB/HDMI capture
         cards are the same FilterCategory.VideoInputDevice). -->
    <PackageReference Include="DirectShowLib.Standard" Version="1.0.0" />
    <!-- MVVM source generators (ObservableObject, RelayCommand). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native prerequisites: Rust transfer engine and the shared ZXing-C++
         decoder. scripts/build-windows.ps1 (or build-all.sh windows) places
         both in runtime/. Loading is deferred to their managed bridges so a
         missing DLL produces a user-facing startup error. -->
    <!-- Generated DLLs are excluded from the SDK's default None glob. Add
         them explicitly and flatten them next to AirFerry.exe. -->
    <None Remove="runtime\transfer_engine.dll" />
    <None Remove="runtime\airferry_zxing.dll" />
    <Content Include="runtime\transfer_engine.dll" Condition="Exists('runtime\transfer_engine.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <TargetPath>transfer_engine.dll</TargetPath>
    </Content>
    <Content Include="runtime\airferry_zxing.dll" Condition="Exists('runtime\airferry_zxing.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <TargetPath>airferry_zxing.dll</TargetPath>
    </Content>
  </ItemGroup>

</Project>
