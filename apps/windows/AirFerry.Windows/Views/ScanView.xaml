<Page x:Class="AirFerry.Windows.Views.ScanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AirFerry - 扫码接收"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: back + title + history. -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0"
                       Appearance="Transparent"
                       Content="返回"
                       Click="Back_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button.Icon>
            </ui:Button>
            <TextBlock Grid.Column="1"
                       Text="扫码接收"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <ui:Button Grid.Column="2"
                       Appearance="Transparent"
                       Content="文件"
                       Click="FileList_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- Camera preview + progress ring. -->
        <Grid Grid.Row="1">
            <Border Background="{DynamicResource PreviewBackdropBrush}"
                    CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <!-- Live camera preview (updated via WriteableBitmap in code-behind). -->
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <!-- Circular progress ring overlaid in the center. -->
                    <Canvas x:Name="ProgressCanvas"
                            Width="180" Height="180"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Continuous receive: keep scanning, save every transfer to one folder. -->
        <ui:Card Grid.Row="2" Margin="0,12,0,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              x:Name="ContinuousToggle"
                              Content="持续接收"
                              Checked="ContinuousToggle_Checked"
                              Unchecked="ContinuousToggle_Unchecked"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="ContinuousDirText"
                               Text=""
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="12,0,12,0"
                               Visibility="Collapsed" />
                    <ui:Button Grid.Column="2"
                               x:Name="ContinuousChangeButton"
                               Appearance="Secondary"
                               Content="更改"
                               Click="ContinuousChange_Click"
                               Visibility="Collapsed"
                               VerticalAlignment="Center">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Folder24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Grid.Column="3"
                               x:Name="ContinuousOpenButton"
                               Appearance="Secondary"
                               Content="打开文件夹"
                               Click="ContinuousOpen_Click"
                               Visibility="Collapsed"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
                <TextBlock Grid.Row="1"
                           x:Name="ContinuousSummaryText"
                           Text=""
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,6,0,0"
                           Visibility="Collapsed" />
                <ScrollViewer Grid.Row="2"
                              x:Name="ContinuousListScroll"
                              MaxHeight="110"
                              Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="ContinuousList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ui:Card>

        <!-- Status card at the bottom. -->
        <ui:Card Grid.Row="3" Margin="0,12,0,0">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StatusText"
                               Text="正在扫描…"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="FileSummaryText"
                               Text="等待描述符…"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="ProgressText"
                               Text="0 / 0"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="TransferMetricsText"
                               Text="解码 0 符号/秒 · 有效 0 B/s · 用时 00:00"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="ScanMetricsText"
                               Text="采集 0 帧 · 丢弃 0 帧 · 解码 0 码"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="RecoveryStageText"
                               Text=""
                               FontSize="13"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               Margin="0,4,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           x:Name="StopButton"
                           Appearance="Secondary"
                           Content="停止"
                           Click="Stop_Click"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Stop24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
