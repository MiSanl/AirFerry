<Page x:Class="AirFerry.Windows.Views.ReceiveBundleView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AirFerry - 接收包"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation and completion status use separate rows. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <ui:Button Appearance="Transparent"
                       Content="返回" Click="Back_Click"
                       HorizontalAlignment="Left">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button.Icon>
            </ui:Button>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Border Width="44" Height="44" CornerRadius="22"
                        Background="{DynamicResource SuccessBrush}">
                    <ui:SymbolIcon Symbol="Checkmark24" Filled="True"
                                   FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="接收完成"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Integrity status. -->
        <ui:InfoBar Grid.Row="1"
                    x:Name="CrcInfoBar"
                    Severity="Informational"
                    IsClosable="False"
                    Margin="0,0,0,12" />

        <ui:Card Grid.Row="2">
            <ListView x:Name="FileListView"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件名" Width="340"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="大小" Width="140"
                                        DisplayMemberBinding="{Binding SizeText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ui:Card>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Appearance="Primary"
                       Content="全部保存" Click="SaveAll_Click"
                       HorizontalAlignment="Stretch">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Grid.Column="2" Appearance="Secondary"
                       Content="打开文件夹" Click="OpenFolder_Click"
                       HorizontalAlignment="Stretch">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Grid.Column="4" Appearance="Transparent"
                       Content="重新扫码" Click="Rescan_Click"
                       HorizontalAlignment="Stretch">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </Grid>
</Page>
