<Application x:Class="AirFerry.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent theme + control styles (WPF-UI). The initial theme is
                     Light; ThemeService swaps it per settings.json "theme". -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- AirFerry semantic tokens not covered by WPF-UI (success /
                     error / warning / camera-preview backdrop). ThemeService
                     re-points this dictionary's Source on theme change. -->
                <ResourceDictionary Source="Themes/DesignTokens.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
